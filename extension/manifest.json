{
  "manifest_version": 3,
  "name": "ClipDock — MP4で保存",
  "version": "1.0.1",
  "description": "Chromeで見ている動画を、ClipDockでMP4に保存。動画上の保存ボタンと検出一覧に対応。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["activeTab", "storage", "nativeMessaging", "webRequest", "webNavigation", "contextMenus"],
  "optional_permissions": ["cookies"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "ClipDockで動画を保存" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true }],
  "incognito": "not_allowed",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
