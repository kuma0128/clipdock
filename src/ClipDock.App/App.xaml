<Application x:Class="ClipDock.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Muted" Color="#596D60" />
    <SolidColorBrush x:Key="Accent" Color="#28734B" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#243C2E" /><Setter Property="Background" Value="#E7F1E9" />
      <Setter Property="Padding" Value="16,10" /><Setter Property="Cursor" Value="Hand" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.8" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#20352B" /><Setter Property="CaretBrush" Value="#28734B" /><Setter Property="BorderBrush" Value="#C6D7CB" /><Setter Property="Padding" Value="12,10" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#20352B" /><Setter Property="Background" Value="White" /><Setter Property="Padding" Value="10,7" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#20352B" /><Setter Property="Background" Value="White" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#20352B" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Padding" Value="4,2" /></Style>
    <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="#4E9970" /><Setter Property="Background" Value="#E4EEE6" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Height" Value="4" /></Style>
  </Application.Resources>
</Application>
