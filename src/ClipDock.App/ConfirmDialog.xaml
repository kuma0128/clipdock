<Window x:Class="ClipDock.App.ConfirmDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" FontSize="13">
  <StackPanel Margin="24">
    <TextBlock x:Name="Message" TextWrapping="Wrap" LineHeight="21" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="Decline" IsCancel="True" />
      <Button x:Name="Accept" IsDefault="True" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="Accept_Click" />
    </StackPanel>
  </StackPanel>
</Window>
