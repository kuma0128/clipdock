<Window x:Class="ClipDock.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipDock — Chromeから、MP4へ。" Width="1120" Height="780" MinWidth="920" MinHeight="660" WindowStartupLocation="CenterScreen" Background="#10171F" Foreground="#EDF2F6" FontFamily="Yu Gothic UI, Segoe UI" FontSize="13">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="228" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#151F29" BorderBrush="#28333E" BorderThickness="0,0,1,0">
      <DockPanel Margin="22,28">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal"><Border Background="#A5E7BA" CornerRadius="10" Width="38" Height="38"><TextBlock Text="↓" Foreground="#14271C" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="ClipDock" FontSize="23" FontWeight="SemiBold" Margin="10,2,0,0" /></StackPanel>
          <TextBlock Text="CHROME VIDEO DOWNLOADER" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,14,0,35" />
          <TextBlock Text="ライブラリ" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0,0,12" />
          <Button x:Name="AllFilter" Content="↓    すべてのダウンロード" HorizontalContentAlignment="Left" Click="Filter_Click" Tag="all" Margin="0,0,0,7" Background="#2B4238" />
          <Button x:Name="ActiveFilter" Content="◷    ダウンロード中" HorizontalContentAlignment="Left" Click="Filter_Click" Tag="active" Margin="0,0,0,7" Background="Transparent" />
          <Button x:Name="CompletedFilter" Content="✓    保存した動画" HorizontalContentAlignment="Left" Click="Filter_Click" Tag="completed" Background="Transparent" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <Border Background="#1D2C2A" CornerRadius="10" Padding="14" Margin="0,0,0,20"><StackPanel><TextBlock Text="ブラウザから、ワンクリック。" FontSize="12" Foreground="#BFE5CD" /><TextBlock Text="動画の上に出る保存ボタン、または拡張アイコンから追加できます。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0" LineHeight="19" /></StackPanel></Border>
          <Button Content="Chrome連携を設定" Click="Register_Click" Margin="0,0,0,8" />
          <Button Content="拡張フォルダーを開く" Click="ExtensionFolder_Click" Margin="0,0,0,8" />
          <Button x:Name="EngineButton" Content="エンジンを準備 / 更新" Click="InstallEngine_Click" Margin="0,0,0,8" />
          <TextBlock x:Name="EngineStatus" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="4,4,0,15" />
          <TextBlock x:Name="VersionLabel" Foreground="#627183" FontSize="10" Margin="4,0,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="32,28,32,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="YOUR VIDEO, READY TO KEEP" FontSize="10" Foreground="{StaticResource Accent}" Margin="0,0,0,8" /><TextBlock Text="ダウンロード" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="見つけた動画を、いつものフォルダーへ。" Foreground="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#21342B" CornerRadius="14" Padding="12,6"><TextBlock Text="●  MP4" Foreground="{StaticResource Accent}" FontSize="11" /></Border></Grid>
      <Border Grid.Row="1" Background="#1A2530" BorderBrush="#2C3947" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,18">
        <StackPanel><TextBlock Text="URLから追加" FontWeight="SemiBold" Margin="0,0,0,12" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /><ColumnDefinition Width="102" /></Grid.ColumnDefinitions><TextBox x:Name="UrlInput" ToolTip="動画ページまたは動画ファイルのURL" KeyDown="UrlInput_KeyDown" AutomationProperties.Name="動画ページのURL" /><ComboBox x:Name="QualityBox" Grid.Column="1" SelectedIndex="1" Margin="10,0" AutomationProperties.Name="最大画質"><ComboBoxItem Content="最高画質" Tag="best" /><ComboBoxItem Content="1080p" Tag="1080" /><ComboBoxItem Content="720p" Tag="720" /><ComboBoxItem Content="480p" Tag="480" /><ComboBoxItem Content="4K" Tag="2160" /></ComboBox><Button Grid.Column="2" Content="↓  追加" Background="#A5E7BA" Foreground="#132B1D" FontWeight="SemiBold" Click="Add_Click" /></Grid><TextBlock Text="Chrome拡張から送信した動画も、ここに表示されます。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" /></StackPanel>
      </Border>
      <Border Grid.Row="2" Background="#1C2B35" CornerRadius="7" Padding="12,10" Margin="0,0,0,18"><TextBlock x:Name="Notice" Text="はじめに「Chrome連携を設定」を押し、拡張フォルダーをChromeに読み込んでください。" Foreground="#C1D5E3" TextWrapping="Wrap" FontSize="12" /></Border>
      <Grid Grid.Row="3" Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="CountLabel" Text="ライブラリ  /  0 件" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="QueueStatus" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" /></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="同時保存" VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0" />
          <ComboBox x:Name="ConcurrencyBox" SelectedIndex="1" Width="68" AutomationProperties.Name="同時保存数" ToolTip="動画の取得から変換までを同時に処理する件数。変更しても進行中の保存は中断しません。"><ComboBoxItem Content="1件" Tag="1" /><ComboBoxItem Content="2件" Tag="2" /><ComboBoxItem Content="3件" Tag="3" /><ComboBoxItem Content="4件" Tag="4" /></ComboBox>
          <Button Content="履歴を消去" Margin="12,0,0,0" Background="Transparent" Foreground="{StaticResource Muted}" Padding="5" FontSize="11" Click="ClearHistory_Click" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="JobList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#19232E" BorderBrush="#2B3744" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,10"><StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="34" Height="38" Background="#293A40" CornerRadius="6" VerticalAlignment="Top"><TextBlock Text="▶" Foreground="#A5E7BA" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" /><TextBlock Text="{Binding Meta}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="2" Text="MP4" Foreground="#A5E7BA" FontSize="10" Margin="12,3,0,0" /></Grid>
          <ProgressBar Value="{Binding Percent, Mode=OneWay}" Margin="0,16,0,12" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding StateLabel}" FontSize="11" Foreground="#B8DFCA" /><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxHeight="72" ToolTip="{Binding Detail}" Margin="0,5,12,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="キャンセル" Padding="10,7" FontSize="11" Click="Cancel_Click" Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}" /><Button Content="元ページ" Padding="10,7" Margin="0,0,6,0" FontSize="11" Click="OpenPage_Click" Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}" ToolTip="ブラウザーで再生を確認し、必要なら拡張から送り直してください。" /><Button Content="再試行" Padding="10,7" FontSize="11" Click="Retry_Click" Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}" ToolTip="ログイン情報が必要な場合は、Chrome拡張から送り直してください。" /><Button Content="開く" Padding="10,7" FontSize="11" Click="OpenFile_Click" Visibility="{Binding IsCompleted, Converter={StaticResource BoolVisibility}}" /><Button Content="場所" Padding="10,7" Margin="6,0,0,0" FontSize="11" Click="ShowFile_Click" Visibility="{Binding IsCompleted, Converter={StaticResource BoolVisibility}}" /></StackPanel></Grid>
        </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,15"><TextBlock Text="↓" FontSize="44" Foreground="#567267" HorizontalAlignment="Center" /><TextBlock Text="保存したい動画を見つけよう" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,10" /><TextBlock Text="Chromeで動画を再生して、「MP4で保存」をクリック。" Foreground="{StaticResource Muted}" TextAlignment="Center" /><TextBlock Text="または、上の入力欄にURLを貼り付けて追加。" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0" /></StackPanel>
      </Grid>
      <Border Grid.Row="5" BorderBrush="#2B3744" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="保存先" FontSize="10" Foreground="{StaticResource Muted}" /><TextBlock x:Name="OutputLabel" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,5,12,0" /></StackPanel><Button Grid.Column="1" Content="変更" Click="ChooseOutput_Click" Padding="12,8" Margin="0,0,8,0" /><Button Grid.Column="2" Content="フォルダーを開く" Click="OpenOutput_Click" Padding="12,8" /></Grid></Border>
    </Grid>
  </Grid>
</Window>
