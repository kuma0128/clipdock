<Window x:Class="ClipDock.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipDock" Width="980" Height="820" MinWidth="740" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" FontFamily="Yu Gothic UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

    <!-- Title bar of the page: the name, an update when one is ready, and the settings. -->
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid Height="56" Margin="24,0,16,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource Accent}">
            <Viewbox Width="17" Height="17"><Path Style="{StaticResource Icon}" Data="{StaticResource IconDownload}" Stroke="{DynamicResource OnAccent}" StrokeThickness="2.4" /></Viewbox>
          </Border>
          <TextBlock Text="ClipDock" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="UpdateButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Click="Update_Click" Margin="0,0,8,0" />
        <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource SubtleButton}" Click="OpenSettings_Click" AutomationProperties.Name="{DynamicResource L0D8619AAE051AE34}">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="18" Height="18"><Path Style="{StaticResource Icon}" Data="{StaticResource IconSettings}" /></Viewbox>
            <TextBlock Text="{DynamicResource L0D8619AAE051AE34}" Margin="8,0,0,1" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24,20,24,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

      <!-- Bars that appear only when something needs attention; nothing is shown while all is well. -->
      <StackPanel>
        <!-- The first engine download: nothing can be saved until it is done. -->
        <Border x:Name="SetupBanner" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
          <DockPanel>
            <Viewbox Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0"><Path Style="{StaticResource Icon}" Data="{StaticResource IconDownload}" Stroke="{DynamicResource Accent}" /></Viewbox>
            <TextBlock x:Name="SetupText" Text="{DynamicResource LFB88DA4E39B9C8F0}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0" />
          </DockPanel>
        </Border>
        <!-- The engine could not be fetched; the reason and a way to try again. -->
        <Border x:Name="EngineBanner" Visibility="Collapsed" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
          <DockPanel>
            <Button x:Name="EngineButton" DockPanel.Dock="Right" Content="{DynamicResource L6AD4BA2E2D7A2BAB}" ToolTip="{DynamicResource L45BAC65D26CA7228}" Click="InstallEngine_Click" Margin="12,0,0,0" />
            <Viewbox Width="18" Height="18" VerticalAlignment="Center"><Path Style="{StaticResource Icon}" Data="{StaticResource IconWarning}" Stroke="{DynamicResource WarnInk}" /></Viewbox>
            <TextBlock x:Name="EngineProblem" Text="{DynamicResource L4D1DDFF0D8F723FD}" Foreground="{DynamicResource WarnInk}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0" />
          </DockPanel>
        </Border>
        <!-- Something the user asked for did not work, or ClipDock could not read or save its data. -->
        <Border x:Name="AlertBar" Visibility="Collapsed" Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource DangerLine}" BorderThickness="1" CornerRadius="8" Padding="14,6,6,6" Margin="0,0,0,16">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="CloseAlert_Click" VerticalAlignment="Top" ToolTip="{DynamicResource LF6C244F98893CD95}" AutomationProperties.Name="{DynamicResource LF6C244F98893CD95}">
              <Viewbox Width="16" Height="16"><Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}" /></Viewbox>
            </Button>
            <Viewbox Width="18" Height="18" VerticalAlignment="Top" Margin="0,7,0,0"><Path Style="{StaticResource Icon}" Data="{StaticResource IconWarning}" Stroke="{DynamicResource Danger}" /></Viewbox>
            <TextBlock x:Name="AlertText" Foreground="{DynamicResource DangerInk}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,8,0" />
          </DockPanel>
        </Border>
      </StackPanel>

      <!-- What to save and how. -->
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,16,20,6">
        <StackPanel>
          <TextBlock Text="{DynamicResource LECA6649EF41ACECC}" Style="{StaticResource SectionTitle}" />
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="UrlInput" MinHeight="40" KeyDown="UrlInput_KeyDown" AutomationProperties.Name="{DynamicResource L81857751E8B7405A}" />
            <TextBlock Text="{DynamicResource L1C79DDCBC8E263E2}" Foreground="{DynamicResource Faint}" Margin="13,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=UrlInput}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <Button x:Name="SaveButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" MinHeight="40" MinWidth="104" Margin="10,0,0,0" Padding="18,0" Click="Add_Click" AutomationProperties.Name="{DynamicResource LA3030BF8F16DC63C}">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="17" Height="17"><Path Style="{StaticResource Icon}" Data="{StaticResource IconDownload}" StrokeThickness="2.2" /></Viewbox>
                <TextBlock Text="{DynamicResource LA3030BF8F16DC63C}" Margin="8,0,0,1" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
          <!-- Why this URL was not added, or what to check about it; cleared as soon as the URL is edited. -->
          <TextBlock x:Name="UrlMessage" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Margin="2,8,0,0" Foreground="{DynamicResource Danger}" />

          <Border Height="1" Background="{DynamicResource Line}" Margin="0,16,0,2" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <TextBlock Text="{DynamicResource LA3FDBA54BDC4A0BA}" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8">
              <Border Background="{DynamicResource Track}" CornerRadius="7" Padding="3" ToolTip="{DynamicResource LE396B8587B0219F1}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="Mp4Option" GroupName="Format" Style="{StaticResource Segment}" Content="MP4" IsChecked="True" AutomationProperties.Name="MP4" />
                  <RadioButton x:Name="Mp3Option" GroupName="Format" Style="{StaticResource Segment}" Content="MP3" AutomationProperties.Name="MP3" />
                </StackPanel>
              </Border>
              <ComboBox x:Name="QualityBox" Width="132" SelectedIndex="2" Margin="10,0,0,0" AutomationProperties.Name="{DynamicResource L430BBAC6929DCDD9}" ToolTip="{DynamicResource L61F942DF3BC46F8C}">
                <ComboBoxItem Content="{DynamicResource LE4CD52B47DEF81BE}" Tag="best" /><ComboBoxItem Content="4K" Tag="2160" /><ComboBoxItem Content="1080p" Tag="1080" /><ComboBoxItem Content="720p" Tag="720" /><ComboBoxItem Content="480p" Tag="480" />
              </ComboBox>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{DynamicResource L56FC579CEECD83FE}" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
              <Viewbox Width="17" Height="17"><Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" Stroke="{DynamicResource Muted}" /></Viewbox>
              <TextBlock x:Name="OutputLabel" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </StackPanel>
            <Button Grid.Row="1" Grid.Column="2" Content="{DynamicResource L029C5A77C78AF330}" Click="ChooseOutput_Click" Margin="0,8" />

            <TextBlock Grid.Row="2" Text="{DynamicResource L216505EBB39AC4E9}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,10,20,0" />
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,12,10">
              <CheckBox x:Name="UseLoginBox" IsChecked="True" AutomationProperties.Name="{DynamicResource L7A0403953F11A527}"><TextBlock Text="{DynamicResource L7A0403953F11A527}" TextWrapping="Wrap" /></CheckBox>
              <TextBlock x:Name="LoginStatus" Text="{DynamicResource L68633A691AE99578}" Style="{StaticResource Caption}" Margin="27,3,0,0" />
            </StackPanel>
            <Button Grid.Row="2" Grid.Column="2" Content="{DynamicResource L9BA14A4F95787046}" Click="Login_Click" VerticalAlignment="Top" Margin="0,8,0,10" ToolTip="{DynamicResource L762D86F88C7CC210}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Saved files; work in progress and anything that failed appear at the top. -->
      <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="20,10,12,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="ListTitle" Text="{DynamicResource L55C0442BCE02DDAF}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
              <Border Background="{DynamicResource Track}" CornerRadius="9" Padding="8,1,8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="CountLabel" Text="0" FontSize="12" Foreground="{DynamicResource Muted}" />
              </Border>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Click="OpenOutput_Click" AutomationProperties.Name="{DynamicResource L8BC9EABC1A1F6BCF}">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="17" Height="17"><Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" /></Viewbox>
                <TextBlock Text="{DynamicResource L8BC9EABC1A1F6BCF}" Margin="8,0,0,1" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl x:Name="JobList" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,14,16,14">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <Border x:Name="Tile" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
                        <Viewbox Width="20" Height="20"><Path x:Name="Kind" Style="{StaticResource Icon}" Data="{StaticResource IconVideo}" Stroke="{DynamicResource Accent}" /></Viewbox>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <StackPanel Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0">
                          <ProgressBar Value="{Binding Percent, Mode=OneWay}" />
                          <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock Text="{Binding StateLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0">
                          <TextBlock x:Name="ProblemLabel" Text="{Binding StateLabel}" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" MaxHeight="72" Margin="0,2,0,0" ToolTip="{Binding Detail}" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource RowButton}" Content="{DynamicResource L3AA692FCAAE417D4}" Click="OpenFile_Click" Visibility="{Binding IsCompleted, Converter={StaticResource BoolVisibility}}" />
                        <Button Style="{StaticResource RowButton}" Content="{DynamicResource L828D4CEC1F3C370D}" Click="ShowFile_Click" Visibility="{Binding IsCompleted, Converter={StaticResource BoolVisibility}}" />
                        <Button Style="{StaticResource RowButton}" Content="{DynamicResource LBCA84EA5C65FEE0E}" Click="Cancel_Click" Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}" />
                        <Button Style="{StaticResource RowButton}" Content="{DynamicResource LFB6CC190949DA044}" Click="Retry_Click" Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}" ToolTip="{DynamicResource L0C61D76B28E56214}" />
                        <Button Style="{StaticResource RowButton}" Content="{DynamicResource LD4CC6DB156473F80}" Click="OpenPage_Click" Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}" ToolTip="{DynamicResource L9036793549DFECC8}" />
                        <Button Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="Remove_Click" Visibility="{Binding CanRemove, Converter={StaticResource BoolVisibility}}" ToolTip="{DynamicResource L08AF4BF2DB0C1D2A}" AutomationProperties.Name="{DynamicResource L08AF4BF2DB0C1D2A}">
                          <Viewbox Width="16" Height="16"><Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}" /></Viewbox>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsAudio}" Value="True"><Setter TargetName="Kind" Property="Data" Value="{StaticResource IconAudio}" /></DataTrigger>
                    <DataTrigger Binding="{Binding CanRetry}" Value="True">
                      <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Track}" /><Setter TargetName="Kind" Property="Stroke" Value="{DynamicResource Muted}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                      <Setter TargetName="Tile" Property="Background" Value="{DynamicResource DangerSoft}" /><Setter TargetName="Kind" Property="Stroke" Value="{DynamicResource Danger}" />
                      <Setter TargetName="ProblemLabel" Property="Foreground" Value="{DynamicResource Danger}" />
                    </DataTrigger>
                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHover}" /></Trigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,8,24,24">
            <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
              <Viewbox Width="24" Height="24"><Path Style="{StaticResource Icon}" Data="{StaticResource IconDownload}" Stroke="{DynamicResource Accent}" /></Viewbox>
            </Border>
            <TextBlock Text="{DynamicResource LCBCFAFAE869EDF3E}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Text="{DynamicResource L0593D6A008472BB9}" Style="{StaticResource Caption}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Settings slide over the right edge; the dimmed page behind closes them. -->
    <Grid x:Name="SettingsLayer" Grid.RowSpan="2" Visibility="Collapsed">
      <Border Background="{DynamicResource Scrim}" MouseLeftButtonDown="SettingsScrim_MouseLeftButtonDown" />
      <Border HorizontalAlignment="Right" Width="380" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.18" /></Border.Effect>
        <DockPanel>
          <Grid DockPanel.Dock="Top" Height="56" Margin="24,0,12,0">
            <TextBlock Text="{DynamicResource L0D8619AAE051AE34}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="CloseSettingsButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseSettings_Click" ToolTip="{DynamicResource LF6C244F98893CD95}" AutomationProperties.Name="{DynamicResource LF6C244F98893CD95}">
              <Viewbox Width="18" Height="18"><Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}" /></Viewbox>
            </Button>
          </Grid>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <TextBlock x:Name="VersionLabel" FontSize="12" Foreground="{DynamicResource Muted}" />
          </Border>
          <ScrollViewer BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24,20,24,24">
              <TextBlock Text="{DynamicResource LF8C893840A2B75F3}" Style="{StaticResource SectionTitle}" />
              <ComboBox x:Name="LanguageBox" Margin="0,10,0,0" AutomationProperties.Name="Language">
                <ComboBoxItem Content="日本語" Tag="ja" /><ComboBoxItem Content="English" Tag="en" />
                <ComboBoxItem Content="简体中文" Tag="zh-CN" /><ComboBoxItem Content="Español" Tag="es" />
              </ComboBox>
              <TextBlock Text="{DynamicResource LE1143839B2C83678}" Style="{StaticResource Caption}" Margin="0,6,0,0" />

              <Border Height="1" Background="{DynamicResource Line}" Margin="0,20" />
              <TextBlock Text="{DynamicResource L785B65759020DE19}" Style="{StaticResource SectionTitle}" />
              <CheckBox x:Name="StartupBox" Margin="0,12,0,0" AutomationProperties.Name="{DynamicResource L41A8AE57B90410C4}" AutomationProperties.HelpText="{DynamicResource LBA9C954406AEAABB}"><TextBlock Text="{DynamicResource L41A8AE57B90410C4}" TextWrapping="Wrap" /></CheckBox>
              <TextBlock Text="{DynamicResource LBA9C954406AEAABB}" Style="{StaticResource Caption}" Margin="27,4,0,0" />

              <Border Height="1" Background="{DynamicResource Line}" Margin="0,20" />
              <TextBlock Text="{DynamicResource LEE2351E65074E8EC}" Style="{StaticResource SectionTitle}" />
              <CheckBox x:Name="BrowserOverlayBox" IsChecked="True" Margin="0,12,0,0" AutomationProperties.Name="{DynamicResource LF493806A7C431D23}"><TextBlock Text="{DynamicResource LF493806A7C431D23}" TextWrapping="Wrap" /></CheckBox>
              <TextBlock Text="{DynamicResource LBA562776974E3B46}" Style="{StaticResource Caption}" Margin="27,4,0,0" />

              <Border Height="1" Background="{DynamicResource Line}" Margin="0,20" />
              <TextBlock Text="{DynamicResource L46775FB65FE38384}" Style="{StaticResource SectionTitle}" />
              <TextBlock x:Name="EngineStatus" Style="{StaticResource Caption}" Margin="0,8,0,0" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
