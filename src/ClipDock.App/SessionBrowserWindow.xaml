<Window x:Class="ClipDock.App.SessionBrowserWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ClipDock — サイトにログイン" Width="1060" Height="800" MinWidth="720" MinHeight="600" WindowStartupLocation="CenterOwner" Background="#F7FAF7" Foreground="#20352B" FontFamily="Yu Gothic UI, Segoe UI" FontSize="13">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="20,18,20,12"><TextBlock Text="サイトにログイン" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="ClipDock用に一度ログインすると、次回から保存に使います。Chromeとは別のログインです。" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
    <DockPanel Grid.Row="1" Margin="20,0,20,12"><Button Content="戻る" Click="Back_Click" Margin="0,0,8,0"/><Button Content="開く" Click="Go_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="Address" KeyDown="Address_KeyDown" AutomationProperties.Name="ログイン先のURL" ToolTip="保存する動画ページのURLを入力してください。"/></DockPanel>
    <Border Grid.Row="2" BorderBrush="#D5E2D8" BorderThickness="0,1"><wv:WebView2 x:Name="Web"/></Border>
    <Grid Grid.Row="3" Margin="20,12,20,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="Status" Text="上の入力欄に、保存するページのURLを入力してください。" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><Button x:Name="RuntimeHelp" Content="WebView2の公式ページ" Visibility="Collapsed" HorizontalAlignment="Left" Padding="0,6" Background="Transparent" Foreground="#236848" Click="Runtime_Click"/></StackPanel><Button Grid.Column="1" Content="ログイン情報を削除" Click="Clear_Click" Margin="0,0,8,0" VerticalAlignment="Center"/><Button Grid.Column="2" Content="このページを取り込む" Background="#C6EBCF" Foreground="#173C27" Click="UsePage_Click" VerticalAlignment="Center"/></Grid>
  </Grid>
</Window>
