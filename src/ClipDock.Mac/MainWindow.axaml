<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:ClipDock.App"
        x:Class="ClipDock.Mac.MainWindow"
        Title="ClipDock" Width="980" Height="820" MinWidth="740" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Page}" Foreground="{StaticResource Ink}" FontSize="13">
  <Window.Styles>
    <Style Selector="Border.row"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Border.row:pointerover"><Setter Property="Background" Value="#FAFBFA" /></Style>
    <Style Selector="Border.tile"><Setter Property="Background" Value="{StaticResource AccentSoft}" /></Style>
    <Style Selector="Border.tile.problem"><Setter Property="Background" Value="{StaticResource Track}" /></Style>
    <Style Selector="Border.tile.failed"><Setter Property="Background" Value="{StaticResource DangerSoft}" /></Style>
    <Style Selector="Path.kind"><Setter Property="Stroke" Value="{StaticResource Accent}" /></Style>
    <Style Selector="Border.problem Path.kind"><Setter Property="Stroke" Value="{StaticResource Muted}" /></Style>
    <Style Selector="Border.failed Path.kind"><Setter Property="Stroke" Value="{StaticResource Danger}" /></Style>
    <Style Selector="TextBlock.failed"><Setter Property="Foreground" Value="{StaticResource Danger}" /></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*">

    <!-- Title bar of the page: the name, an update when one is ready, and the settings. -->
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid Height="56" Margin="24,0,16,0" ColumnDefinitions="*,Auto,Auto">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource Accent}">
            <Viewbox Width="17" Height="17"><Path Classes="icon" Data="{StaticResource IconDownload}" Stroke="White" StrokeThickness="2.4" /></Viewbox>
          </Border>
          <TextBlock Text="ClipDock" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="UpdateButton" Grid.Column="1" Classes="primary" IsVisible="False" Click="Update_Click" Margin="0,0,8,0" />
        <Button x:Name="SettingsButton" Grid.Column="2" Classes="subtle" Click="OpenSettings_Click" AutomationProperties.Name="{DynamicResource L0D8619AAE051AE34}">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="18" Height="18"><Path Classes="icon" Data="{StaticResource IconSettings}" /></Viewbox>
            <TextBlock Text="{DynamicResource L0D8619AAE051AE34}" Margin="8,0,0,1" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24,20,24,24" RowDefinitions="Auto,Auto,Auto,*">

      <!-- Shown only when the engine could not be fetched: nothing can be saved until it is. -->
      <Border x:Name="EngineBanner" IsVisible="False" Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnLine}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
        <DockPanel>
          <Button x:Name="EngineButton" DockPanel.Dock="Right" Content="{DynamicResource L6AD4BA2E2D7A2BAB}" ToolTip.Tip="{DynamicResource L45BAC65D26CA7228}" Click="InstallEngine_Click" Margin="12,0,0,0" />
          <Viewbox Width="18" Height="18" VerticalAlignment="Center"><Path Classes="icon" Data="{StaticResource IconWarning}" Stroke="{StaticResource WarnInk}" /></Viewbox>
          <TextBlock Text="{DynamicResource L4D1DDFF0D8F723FD}" Foreground="{StaticResource WarnInk}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0" />
        </DockPanel>
      </Border>

      <!-- What to save and how. -->
      <Border Grid.Row="1" Classes="card" Padding="20,16,20,6">
        <StackPanel>
          <TextBlock Text="{DynamicResource LECA6649EF41ACECC}" Classes="section" />
          <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto">
            <TextBox x:Name="UrlInput" MinHeight="40" PlaceholderText="{DynamicResource L1C79DDCBC8E263E2}" KeyDown="UrlInput_KeyDown" AutomationProperties.Name="{DynamicResource L81857751E8B7405A}" />
            <Button x:Name="SaveButton" Grid.Column="1" Classes="primary" MinHeight="40" MinWidth="104" Margin="10,0,0,0" Padding="18,0" Click="Add_Click" AutomationProperties.Name="{DynamicResource LA3030BF8F16DC63C}">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="17" Height="17"><Path Classes="icon" Data="{StaticResource IconDownload}" StrokeThickness="2.2" /></Viewbox>
                <TextBlock Text="{DynamicResource LA3030BF8F16DC63C}" Margin="8,0,0,1" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,2" />
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Text="{DynamicResource LA3FDBA54BDC4A0BA}" Classes="label" />
            <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8">
              <Border Background="{StaticResource Track}" CornerRadius="7" Padding="3" ToolTip.Tip="{DynamicResource LE396B8587B0219F1}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="Mp4Option" GroupName="Format" Theme="{StaticResource Segment}" Content="MP4" IsChecked="True" AutomationProperties.Name="MP4" />
                  <RadioButton x:Name="Mp3Option" GroupName="Format" Theme="{StaticResource Segment}" Content="MP3" AutomationProperties.Name="MP3" />
                </StackPanel>
              </Border>
              <ComboBox x:Name="QualityBox" Width="132" SelectedIndex="2" Margin="10,0,0,0" AutomationProperties.Name="{DynamicResource L430BBAC6929DCDD9}" ToolTip.Tip="{DynamicResource L61F942DF3BC46F8C}">
                <ComboBoxItem Content="{DynamicResource LE4CD52B47DEF81BE}" Tag="best" /><ComboBoxItem Content="4K" Tag="2160" /><ComboBoxItem Content="1080p" Tag="1080" /><ComboBoxItem Content="720p" Tag="720" /><ComboBoxItem Content="480p" Tag="480" />
              </ComboBox>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{DynamicResource L56FC579CEECD83FE}" Classes="label" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
              <Viewbox Width="17" Height="17"><Path Classes="icon" Data="{StaticResource IconFolder}" Stroke="{StaticResource Muted}" /></Viewbox>
              <TextBlock x:Name="OutputLabel" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Row="1" Grid.Column="2" Content="{DynamicResource L029C5A77C78AF330}" Click="ChooseOutput_Click" Margin="0,8" />

            <TextBlock Grid.Row="2" Text="{DynamicResource L216505EBB39AC4E9}" Classes="label" VerticalAlignment="Top" Margin="0,10,20,0" />
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,12,10">
              <CheckBox x:Name="UseLoginBox" IsChecked="True" AutomationProperties.Name="{DynamicResource L7A0403953F11A527}"><TextBlock Text="{DynamicResource L7A0403953F11A527}" TextWrapping="Wrap" /></CheckBox>
              <TextBlock x:Name="LoginStatus" Text="{DynamicResource L68633A691AE99578}" Classes="caption" Margin="28,0,0,0" />
            </StackPanel>
            <Button Grid.Row="2" Grid.Column="2" Content="{DynamicResource L9BA14A4F95787046}" Click="Login_Click" VerticalAlignment="Top" Margin="0,8,0,10" ToolTip.Tip="{DynamicResource L762D86F88C7CC210}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- The latest message about what ClipDock did or needs. -->
      <DockPanel Grid.Row="2" Margin="4,12,4,0">
        <Viewbox Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0"><Path Classes="icon" Data="{StaticResource IconInfo}" Stroke="{StaticResource Muted}" /></Viewbox>
        <TextBlock x:Name="Notice" Text="{DynamicResource LFD341411F2BFD178}" Classes="caption" FontSize="12.5" Margin="8,0,0,0" />
      </DockPanel>

      <!-- Saved files; work in progress and anything that failed appear at the top. -->
      <Border Grid.Row="3" Classes="card" Margin="0,16,0,0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <Grid Margin="20,10,12,10" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="ListTitle" Text="{DynamicResource L55C0442BCE02DDAF}" Classes="section" VerticalAlignment="Center" />
              <Border Background="{StaticResource Track}" CornerRadius="9" Padding="8,1,8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="CountLabel" Text="0" FontSize="12" Foreground="{StaticResource Muted}" />
              </Border>
            </StackPanel>
            <Button Grid.Column="1" Classes="subtle" Click="OpenOutput_Click" AutomationProperties.Name="{DynamicResource L8BC9EABC1A1F6BCF}">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="17" Height="17"><Path Classes="icon" Data="{StaticResource IconFolder}" /></Viewbox>
                <TextBlock Text="{DynamicResource L8BC9EABC1A1F6BCF}" Margin="8,0,0,1" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="JobList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="app:DownloadItem">
                  <Border Classes="row" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,14,16,14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Classes="tile" Width="40" Height="40" CornerRadius="8" VerticalAlignment="Top" Classes.problem="{Binding CanRetry}" Classes.failed="{Binding IsFailed}">
                        <Panel>
                          <Viewbox Width="20" Height="20" IsVisible="{Binding !IsAudio}"><Path Classes="icon kind" Data="{StaticResource IconVideo}" /></Viewbox>
                          <Viewbox Width="20" Height="20" IsVisible="{Binding IsAudio}"><Path Classes="icon kind" Data="{StaticResource IconAudio}" /></Viewbox>
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                        <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <StackPanel IsVisible="{Binding CanCancel}" Margin="0,10,0,0">
                          <ProgressBar Value="{Binding Percent, Mode=OneWay}" Minimum="0" Maximum="100" />
                          <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock Text="{Binding StateLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding CanRetry}" Margin="0,8,0,0">
                          <TextBlock Text="{Binding StateLabel}" FontSize="12" FontWeight="SemiBold" Classes.failed="{Binding IsFailed}" />
                          <TextBlock Text="{Binding Detail}" Classes="caption" MaxHeight="72" Margin="0,2,0,0" ToolTip.Tip="{Binding Detail}" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Classes="row" Content="{DynamicResource L3AA692FCAAE417D4}" Click="OpenFile_Click" IsVisible="{Binding IsCompleted}" />
                        <Button Classes="row" Content="{DynamicResource L828D4CEC1F3C370D}" Click="ShowFile_Click" IsVisible="{Binding IsCompleted}" ToolTip.Tip="{DynamicResource LE00F25E90B3B4068}" />
                        <Button Classes="row" Content="{DynamicResource LBCA84EA5C65FEE0E}" Click="Cancel_Click" IsVisible="{Binding CanCancel}" />
                        <Button Classes="row" Content="{DynamicResource LFB6CC190949DA044}" Click="Retry_Click" IsVisible="{Binding CanRetry}" ToolTip.Tip="{DynamicResource L0C61D76B28E56214}" />
                        <Button Classes="row" Content="{DynamicResource LD4CC6DB156473F80}" Click="OpenPage_Click" IsVisible="{Binding CanRetry}" ToolTip.Tip="{DynamicResource L9036793549DFECC8}" />
                        <Button Classes="icon" Margin="4,0,0,0" Click="Remove_Click" IsVisible="{Binding CanRemove}" ToolTip.Tip="{DynamicResource L08AF4BF2DB0C1D2A}" AutomationProperties.Name="{DynamicResource L08AF4BF2DB0C1D2A}">
                          <Viewbox Width="16" Height="16"><Path Classes="icon" Data="{StaticResource IconClose}" /></Viewbox>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,8,24,24">
            <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center">
              <Viewbox Width="24" Height="24"><Path Classes="icon" Data="{StaticResource IconDownload}" Stroke="{StaticResource Accent}" /></Viewbox>
            </Border>
            <TextBlock Text="{DynamicResource LCBCFAFAE869EDF3E}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Text="{DynamicResource L0593D6A008472BB9}" Classes="caption" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Settings slide over the right edge; the dimmed page behind closes them. -->
    <Panel x:Name="SettingsLayer" Grid.RowSpan="2" IsVisible="False">
      <Border Background="#401B2620" PointerPressed="SettingsScrim_PointerPressed" />
      <Border HorizontalAlignment="Right" Width="380" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" BoxShadow="0 0 28 0 #2E000000">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Height="56" Margin="24,0,12,0">
            <TextBlock Text="{DynamicResource L0D8619AAE051AE34}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="CloseSettingsButton" Classes="icon" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseSettings_Click" ToolTip.Tip="{DynamicResource LF6C244F98893CD95}" AutomationProperties.Name="{DynamicResource LF6C244F98893CD95}">
              <Viewbox Width="18" Height="18"><Path Classes="icon" Data="{StaticResource IconClose}" /></Viewbox>
            </Button>
          </Grid>
          <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <TextBlock x:Name="VersionLabel" FontSize="12" Foreground="{StaticResource Muted}" />
          </Border>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="24,20,24,24">
                <TextBlock Text="{DynamicResource LF8C893840A2B75F3}" Classes="section" />
                <ComboBox x:Name="LanguageBox" Margin="0,10,0,0" HorizontalAlignment="Stretch" AutomationProperties.Name="Language">
                  <ComboBoxItem Content="日本語" Tag="ja" /><ComboBoxItem Content="English" Tag="en" />
                  <ComboBoxItem Content="简体中文" Tag="zh-CN" /><ComboBoxItem Content="Español" Tag="es" />
                </ComboBox>
                <TextBlock Text="{DynamicResource LE1143839B2C83678}" Classes="caption" Margin="0,6,0,0" />

                <Border Height="1" Background="{StaticResource Line}" Margin="0,20" />
                <TextBlock Text="{DynamicResource L785B65759020DE19}" Classes="section" />
                <CheckBox x:Name="StartAtLoginBox" Margin="0,8,0,0" AutomationProperties.Name="{DynamicResource L42FF1836ECFA8EA2}" AutomationProperties.HelpText="{DynamicResource L761CB756BD82ED11}"><TextBlock Text="{DynamicResource L42FF1836ECFA8EA2}" TextWrapping="Wrap" /></CheckBox>
                <TextBlock Text="{DynamicResource L761CB756BD82ED11}" Classes="caption" Margin="28,0,0,0" />

                <Border Height="1" Background="{StaticResource Line}" Margin="0,20" />
                <TextBlock Text="{DynamicResource L46775FB65FE38384}" Classes="section" />
                <TextBlock x:Name="EngineStatus" Classes="caption" Margin="0,8,0,0" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Border>
    </Panel>

    <!-- Holds the app's sign-in session so cookies can be read while the sign-in window is closed.
         Kept last and out of the accessibility tree: assistive tools must not walk into an empty web view. -->
    <NativeWebView x:Name="SessionStore" Grid.Row="1" Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   IsHitTestVisible="False" Focusable="False" IsTabStop="False" AutomationProperties.AccessibilityView="Raw" />
  </Grid>
</Window>
