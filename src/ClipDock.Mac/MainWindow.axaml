<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:ClipDock.App"
        x:Class="ClipDock.Mac.MainWindow"
        Title="ClipDock" Width="1200" Height="820" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen"
        Background="#F8FBF8" Foreground="#20352B" FontSize="13">
  <Grid ColumnDefinitions="260,*">
    <Border Background="#F0F7F1" BorderBrush="#D5E2D8" BorderThickness="0,0,1,0">
      <DockPanel Margin="22,28">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal">
            <Border Background="#C6EBCF" CornerRadius="10" Width="38" Height="38"><TextBlock Text="↓" Foreground="#14271C" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Text="ClipDock" FontSize="23" FontWeight="SemiBold" Margin="10,2,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{DynamicResource LA2C566E9CCD4D17E}" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,35,0,12" />
          <Button x:Name="AllFilter" Content="{DynamicResource LE34BC643EC3EFE5F}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Filter_Click" Tag="all" Margin="0,0,0,7" Background="#D9EEDF" />
          <Button x:Name="ActiveFilter" Content="{DynamicResource L7EB9BF73FA0C244C}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Filter_Click" Tag="active" Margin="0,0,0,7" Background="Transparent" />
          <Button x:Name="CompletedFilter" Content="{DynamicResource L97C0A44601C0FEEE}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Filter_Click" Tag="completed" Background="Transparent" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <TextBlock Text="{DynamicResource LA0E52010AB570C2A}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6" />
          <ComboBox x:Name="LanguageBox" Margin="0,0,0,16" AutomationProperties.Name="Language">
            <ComboBoxItem Content="日本語" Tag="ja" /><ComboBoxItem Content="English" Tag="en" />
            <ComboBoxItem Content="简体中文" Tag="zh-CN" /><ComboBoxItem Content="Español" Tag="es" />
          </ComboBox>
          <Button x:Name="EngineButton" Content="{DynamicResource L6AD4BA2E2D7A2BAB}" HorizontalAlignment="Stretch" ToolTip.Tip="{DynamicResource L45BAC65D26CA7228}" Click="InstallEngine_Click" Margin="0,0,0,8" />
          <TextBlock x:Name="EngineStatus" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="4,4,0,15" />
          <TextBlock x:Name="VersionLabel" Foreground="#5C7163" FontSize="10" Margin="4,0,0,0" />
        </StackPanel>
        <Panel />
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="32,28,32,24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
      <Grid Margin="0,0,0,24">
        <StackPanel>
          <TextBlock Text="ClipDock for Mac" FontSize="10" Foreground="{StaticResource Accent}" Margin="0,0,0,8" />
          <TextBlock Text="{DynamicResource LB85D7A94AE5775CF}" FontSize="30" FontWeight="SemiBold" />
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E6F4E9" CornerRadius="14" Padding="12,6"><TextBlock Text="MP4 / MP3" Foreground="{StaticResource Accent}" FontSize="11" /></Border>
      </Grid>
      <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D5E2D8" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,18">
        <StackPanel>
          <TextBlock Text="{DynamicResource LECA6649EF41ACECC}" FontWeight="SemiBold" Margin="0,0,0,12" />
          <Grid ColumnDefinitions="*,98,122,110">
            <TextBox x:Name="UrlInput" ToolTip.Tip="{DynamicResource L1C79DDCBC8E263E2}" KeyDown="UrlInput_KeyDown" AutomationProperties.Name="{DynamicResource L81857751E8B7405A}" />
            <ComboBox x:Name="FormatBox" Grid.Column="1" SelectedIndex="0" Margin="10,0,0,0" AutomationProperties.Name="{DynamicResource LA3FDBA54BDC4A0BA}">
              <ComboBoxItem Content="MP4" Tag="mp4" /><ComboBoxItem Content="MP3" Tag="mp3" />
            </ComboBox>
            <ComboBox x:Name="QualityBox" Grid.Column="2" SelectedIndex="1" Margin="10,0" AutomationProperties.Name="{DynamicResource L430BBAC6929DCDD9}" ToolTip.Tip="{DynamicResource L61F942DF3BC46F8C}">
              <ComboBoxItem Content="{DynamicResource LE4CD52B47DEF81BE}" Tag="best" /><ComboBoxItem Content="1080p" Tag="1080" /><ComboBoxItem Content="720p" Tag="720" /><ComboBoxItem Content="480p" Tag="480" /><ComboBoxItem Content="4K" Tag="2160" />
            </ComboBox>
            <Button Grid.Column="3" Content="{DynamicResource LA9FB576FF2085565}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#C6EBCF" Foreground="#132B1D" FontWeight="SemiBold" Click="Add_Click" />
          </Grid>
          <Grid Margin="0,15,0,0" ColumnDefinitions="*,Auto">
            <StackPanel>
              <CheckBox x:Name="UseLoginBox" IsChecked="True" Content="{DynamicResource L7A0403953F11A527}" AutomationProperties.Name="{DynamicResource L7A0403953F11A527}" />
              <TextBlock x:Name="LoginStatus" Text="{DynamicResource L68633A691AE99578}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,10,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource L9BA14A4F95787046}" Click="Login_Click" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource L762D86F88C7CC210}" />
          </Grid>
          <TextBlock Text="{DynamicResource LE396B8587B0219F1}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" />
        </StackPanel>
      </Border>
      <Border Grid.Row="2" Background="#F0F8F2" BorderBrush="#BBD7C4" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel>
            <TextBlock Text="{DynamicResource L56FC579CEECD83FE}" FontSize="12" Foreground="{StaticResource Muted}" />
            <TextBlock x:Name="OutputLabel" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,5,12,0" />
          </StackPanel>
          <Button Grid.Column="1" Content="{DynamicResource L029C5A77C78AF330}" Click="ChooseOutput_Click" Background="#C6EBCF" Foreground="#132B1D" FontWeight="SemiBold" Padding="14,10" Margin="0,0,8,0" />
          <Button Grid.Column="2" Content="{DynamicResource L3AA692FCAAE417D4}" Click="OpenOutput_Click" Padding="12,10" />
        </Grid>
      </Border>
      <Border Grid.Row="3" Background="#EDF5EF" CornerRadius="7" Padding="12,10" Margin="0,0,0,18"><TextBlock x:Name="Notice" Text="{DynamicResource LFD341411F2BFD178}" Foreground="#435F4D" TextWrapping="Wrap" FontSize="12" /></Border>
      <Grid Grid.Row="4" Margin="0,0,0,12" ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="CountLabel" Text="{DynamicResource L83A36F5E84CE770A}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="QueueStatus" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource L639E1CA76CC8DC4D}" VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0" />
          <ComboBox x:Name="ConcurrencyBox" SelectedIndex="1" Width="84" AutomationProperties.Name="{DynamicResource LA01A07639E0A085C}" ToolTip.Tip="{DynamicResource L79E2DA1C44FFDC5C}">
            <ComboBoxItem Content="{DynamicResource L7C5C530C163593ED}" Tag="1" /><ComboBoxItem Content="{DynamicResource L70FC972FC96CD327}" Tag="2" /><ComboBoxItem Content="{DynamicResource L9A285BFDC86F63A3}" Tag="3" /><ComboBoxItem Content="{DynamicResource L842FAFA010EAF64E}" Tag="4" />
          </ComboBox>
          <Button Content="{DynamicResource L86815601500BEC8E}" Margin="12,0,0,0" Background="Transparent" Foreground="{StaticResource Muted}" Padding="5" FontSize="11" Click="ClearHistory_Click" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="5">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="JobList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="app:DownloadItem">
                <Border Background="#FFFFFF" BorderBrush="#D5E2D8" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,10">
                  <StackPanel>
                    <Grid ColumnDefinitions="46,*,Auto">
                      <Border Width="34" Height="38" Background="#E7F4EB" CornerRadius="6" VerticalAlignment="Top" HorizontalAlignment="Left"><TextBlock Text="▶" Foreground="#28734B" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                        <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding FormatLabel}" Foreground="#28734B" FontSize="10" Margin="12,3,0,0" />
                    </Grid>
                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,16,0,12" />
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="{Binding StateLabel}" FontSize="11" Foreground="#316748" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxHeight="72" ToolTip.Tip="{Binding Detail}" Margin="0,5,12,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="{DynamicResource LBCA84EA5C65FEE0E}" Padding="10,7" FontSize="11" Click="Cancel_Click" IsVisible="{Binding CanCancel}" />
                        <Button Content="{DynamicResource LD4CC6DB156473F80}" Padding="10,7" Margin="0,0,6,0" FontSize="11" Click="OpenPage_Click" IsVisible="{Binding CanRetry}" ToolTip.Tip="{DynamicResource L9036793549DFECC8}" />
                        <Button Content="{DynamicResource LFB6CC190949DA044}" Padding="10,7" FontSize="11" Click="Retry_Click" IsVisible="{Binding CanRetry}" ToolTip.Tip="{DynamicResource L0C61D76B28E56214}" />
                        <Button Content="{DynamicResource L3AA692FCAAE417D4}" Padding="10,7" FontSize="11" Click="OpenFile_Click" IsVisible="{Binding IsCompleted}" />
                        <Button Content="{DynamicResource L828D4CEC1F3C370D}" Padding="10,7" Margin="6,0,0,0" FontSize="11" Click="ShowFile_Click" IsVisible="{Binding IsCompleted}" ToolTip.Tip="{DynamicResource LE00F25E90B3B4068}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,15">
          <TextBlock Text="↓" FontSize="44" Foreground="#4D8060" HorizontalAlignment="Center" />
          <TextBlock Text="{DynamicResource L0593D6A008472BB9}" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,12,0,0" />
          <TextBlock Text="{DynamicResource L68633A691AE99578}" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>
      </Grid>
    </Grid>
    <!-- Holds the app's sign-in session so cookies can be read while the sign-in window is closed.
         Kept last and out of the accessibility tree: assistive tools must not walk into an empty web view. -->
    <NativeWebView x:Name="SessionStore" Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   IsHitTestVisible="False" Focusable="False" IsTabStop="False" AutomationProperties.AccessibilityView="Raw" />
  </Grid>
</Window>
